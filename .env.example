# MongoDB Connection
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/nexuscart?retryWrites=true&w=majority"

# JWT Secret for Authentication
JWT_SECRET="your_super_secret_jwt_key_here"

# The only account that can ever hold the Admin role (auth-service and
# admin-service both check this).
SUPER_ADMIN_EMAIL="you@yourdomain.com"

# Brevo transactional email (notification-service)
BREVO_API_KEY="your_brevo_api_key_here"
BREVO_SENDER_EMAIL="no-reply@yourdomain.com"
BREVO_SENDER_NAME="NexusCart"

# Optional — Brevo dynamic template IDs (Transactional > Templates).
# Leave unset to use the built-in inline HTML instead.
BREVO_OTP_TEMPLATE_ID=""
BREVO_RESET_TEMPLATE_ID=""
BREVO_INVOICE_TEMPLATE_ID=""

# Public site URL — used by notification-service to build invoice links in
# order confirmation/status emails. Falls back to localhost:3000 if unset.
FRONTEND_URL="https://yourdomain.com"

# PayHere payment gateway (payment-service). Get these from your PayHere
# Merchant Account under Settings > Domains & Credentials — use a Sandbox
# account for testing (https://sandbox.payhere.lk). Set PAYHERE_SANDBOX to
# "false" only when switching to a live merchant account.
PAYHERE_MERCHANT_ID="your_payhere_merchant_id"
PAYHERE_MERCHANT_SECRET="your_payhere_merchant_secret"
PAYHERE_SANDBOX="true"

# Shared secret for service-to-service calls with no customer JWT available —
# currently used by payment-service to mark an order PAID after PayHere's
# notify webhook confirms payment. Must match on both payment-service and
# order-service. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_KEY="a_long_random_shared_secret"

# The API gateway's PUBLICLY reachable URL (external ingress) — PayHere's
# notify webhook is a server-to-server call from PayHere's own infrastructure
# and must hit this directly, not the frontend's proxy. For Azure Container
# Apps this is the gateway's external FQDN (no ".internal."), e.g.
# https://api-gateway.<env-id>.<region>.azurecontainerapps.io
# For local testing, PayHere can't reach localhost — tunnel with ngrok and
# put the ngrok HTTPS URL here instead.
API_GATEWAY_PUBLIC_URL="https://api-gateway.yourdomain.azurecontainerapps.io"

# -------------------------------------------------------------
# Microservice Internal URLs (For Azure Container Apps)
# -------------------------------------------------------------
# These should point to the internal FQDN of your container apps.
# Example: http://auth-service.internal.[unique-id].eastus.azurecontainerapps.io
# If running locally, you can leave these blank as they fallback to 127.0.0.1.

AUTH_SERVICE_URL="http://auth-service.internal.xxx"
BUSINESS_SERVICE_URL="http://business-service.internal.xxx"
PRODUCT_SERVICE_URL="http://product-service.internal.xxx"
ADMIN_SERVICE_URL="http://admin-service.internal.xxx"
ORDER_SERVICE_URL="http://order-service.internal.xxx"
PAYMENT_SERVICE_URL="http://payment-service.internal.xxx"
NOTIFICATION_SERVICE_URL="http://notification-service.internal.xxx"
REVIEW_SERVICE_URL="http://review-rating-service.internal.xxx"
