# MongoDB Connection
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/nexuscart?retryWrites=true&w=majority"

# JWT Secret for Authentication
JWT_SECRET="your_super_secret_jwt_key_here"

# -------------------------------------------------------------
# Microservice Internal URLs (For Azure Container Apps)
# -------------------------------------------------------------
# These should point to the internal FQDN of your container apps.
# Example: http://auth-service.internal.[unique-id].eastus.azurecontainerapps.io
# If running locally, you can leave these blank as they fallback to 127.0.0.1.

AUTH_SERVICE_URL="http://auth-service.internal.xxx"
BUSINESS_SERVICE_URL="http://business-service.internal.xxx"
PRODUCT_SERVICE_URL="http://product-service.internal.xxx"
ADMIN_SERVICE_URL="http://admin-service.internal.xxx"
ORDER_SERVICE_URL="http://order-service.internal.xxx"
PAYMENT_SERVICE_URL="http://payment-service.internal.xxx"
NOTIFICATION_SERVICE_URL="http://notification-service.internal.xxx"
REVIEW_SERVICE_URL="http://review-rating-service.internal.xxx"
